# statuspage — окружение (все параметры опциональны, есть дефолты)

# Токен админки инцидентов (сменить в проде!)
STATUS_ADMIN_TOKEN=change-me

# БД: sqlite по умолчанию (файл). Для прода — Postgres:
#   STATUS_DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/statuspage
# Схема и индексы создаются на старте, миграции не нужны.
STATUS_DATABASE_URL=sqlite:////data/statuspage.db

# Монитор
STATUS_CHECK_INTERVAL=60      # интервал проверок, сек
STATUS_CHECK_TIMEOUT=10
STATUS_HISTORY_DAYS=90
STATUS_ALERT_AFTER=3          # неудач подряд до авто-инцидента
STATUS_RECOVER_AFTER=2        # успехов подряд до авто-закрытия (защита от флапа)
STATUS_FLAP_COOLDOWN=300      # сек: не заводить новый инцидент сразу после закрытия
STATUS_DEGRADED_MS=1500       # ответ дольше — статус «Замедление» (жёлтый)

# Безопасность
STATUS_COOKIE_SECURE=false    # true за https в проде

# Публичный адрес витрины (ставится в текст Telegram-уведомлений)
STATUS_PUBLIC_BASE_URL=http://localhost:8090

# Telegram-уведомления (пусто → уведомления отключены)
STATUS_TELEGRAM_BOT_TOKEN=
# секрет в пути вебхука: /telegram/webhook/<secret>
STATUS_TELEGRAM_WEBHOOK_SECRET=
# затравка подписчиков (через запятую), напр. -1001234567890
STATUS_TELEGRAM_CHAT_IDS=
# чаты с правами админ-команд бота (по умолчанию = STATUS_TELEGRAM_CHAT_IDS)
STATUS_TELEGRAM_ADMIN_CHAT_IDS=
# ссылка на бота для кнопки «Подписаться» (можно задать и в config.json → brand.telegram_url)
STATUS_TELEGRAM_URL=

# Бренд (перекрывает config.json)
# STATUS_BRAND_NAME=
# STATUS_PAGE_TITLE=
# STATUS_CONFIG_FILE=/app/config.json
